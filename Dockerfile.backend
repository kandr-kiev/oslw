# OSLW Backend — FastAPI + Uvicorn
FROM python:3.12-slim AS base

WORKDIR /app

# Залежності системи
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Копіюємо pyproject.toml для кешування pip
COPY pyproject.toml .

# Встановлюємо Python залежності
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# Копіюємо джерела
COPY src/ src/

# Монтуємо wiki (volume при запуску)
# VOLUME /workspace/llm-wiki

EXPOSE 8000

ENV PYTHONUNBUFFERED=1
ENV OSLW_API_HOST=0.0.0.0
ENV OSLW_API_PORT=8000

CMD ["uvicorn", "oslw.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
